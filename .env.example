# VaultPay — Environment Configuration Template
# Copy this file to .env and replace secrets with secure values

# Flask Environment: 'development', 'testing', or 'production'
FLASK_ENV=development

# Secret key for session cookie signing and CSRF tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# AES-256-GCM Master Encryption Key (Base64-encoded 32-byte key)
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Optional: Custom database URL (defaults to instance/wallet.sqlite)
# DATABASE_URL=sqlite:///instance/wallet.sqlite
